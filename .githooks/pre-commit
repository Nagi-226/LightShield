#!/bin/bash
# =============================================================================
# LightShield Pre-commit Compliance Hook（Gate A）
# =============================================================================
# 用途：自动执行 R1-R6 合规扫描，拦截违规代码。
# 运行方式：被 pre-commit 框架调用（.pre-commit-config.yaml 中的 local hook）
#          也可直接运行：bash .githooks/pre-commit
#
# 重要：本 hook 仅扫描 lightshield/ 源码目录。
#       tests/ 测试代码天然包含合规测试所需的黑名单术语（如 assert is_module_allowed("exploit/...")），
#       因此不在合规扫描范围内——测试代码的正确性由 pytest 保证，合规检查由本 hook 的其他部分覆盖。
#       constants.py 中的黑名单常量定义也被排除（BLOCKED_MSF_PREFIXES / ALLOWED_MSF_PREFIXES）。
# =============================================================================

echo "🛡️  LightShield Gate A — 合规扫描中..."

PASS=true

# =============================================================================
# R1 + R3: 攻击/后门关键字黑名单
# =============================================================================
# 排除:
#   - 注释行（# 开头）
#   - 黑名单常量定义（BLOCKED_/ALLOWED_）
#   - 黑名单测试断言（is_module_allowed / exec_msf_module / SecurityViolation）
#   - assert 语句（测试用）
echo "  [R1/R3] 关键字扫描..."

# 先获取所有命中行（排除 constants.py — 它定义黑名单常量本身）
RAW_VIOLATIONS=$(grep -rInE \
    "exploit|payload_creator|payload_injection|backdoor|trojan|bind_shell|reverse_shell|ransomware|botnet|rat_server|keylogger" \
    lightshield/ --include="*.py" 2>/dev/null \
    | grep -v "lightshield/utils/constants.py")

# 过滤掉合法的测试/注释/常量定义上下文
VIOLATIONS=$(echo "$RAW_VIOLATIONS" \
    | grep -v "#" \
    | grep -v "BLOCKED_MSF_PREFIXES\|ALLOWED_MSF_PREFIXES\|R1_ATTACK_KEYWORDS" \
    | grep -v "is_module_allowed\|exec_msf_module\|SecurityViolationError" \
    | grep -v "def test_\|assert " \
    | grep -v "MSF 白名单不得包含" \
    | grep -v "^$" || true)

if [ -n "$VIOLATIONS" ]; then
    echo "  ❌ R1/R3 违规：检测到攻击/后门关键字（已排除测试和常量定义）"
    echo "$VIOLATIONS"
    PASS=false
else
    echo "  ✅ R1/R3 通过"
fi

# =============================================================================
# R5: MSF 白名单路径验证
# =============================================================================
# 检查所有 MSF 引用是否仅使用白名单路径（auxiliary/scanner/ 子集）
# 排除:
#   - 常量定义中的黑名单路径（BLOCKED_MSF_PREFIXES）
#   - 测试断言（is_module_allowed / assert）
#   - 注释行
echo "  [R5] MSF 路径白名单..."

# 使用 grep -rn（含文件名）以便排除 constants.py
MSF_RAW=$(grep -rn "auxiliary/" lightshield/ --include="*.py" 2>/dev/null \
    | grep -v "lightshield/utils/constants.py" \
    | grep -v "auxiliary/scanner/" \
    | grep -v "BLOCKED_MSF_PREFIXES" \
    | grep -v "ALLOWED_MSF_PREFIXES" \
    | grep -v "is_module_allowed" \
    | grep -v "assert " \
    | grep -v "#\|//\|仅允许 auxiliary" \
    | grep -v "^$" || true)

# 去掉文件名，只保留行内容（用于最终展示）
MSF_VIOLATIONS=$(echo "$MSF_RAW" | sed 's|^[^:]*:||' | grep -v "^$" || true)

if [ -n "$MSF_VIOLATIONS" ]; then
    echo "  ❌ R5 违规：检测到非白名单 MSF auxiliary 路径（已排除测试和常量）"
    echo "$MSF_VIOLATIONS"
    PASS=false
else
    echo "  ✅ R5 通过"
fi

# =============================================================================
# R2: CIDR / IP 段扫描检测
# =============================================================================
# 排除:
#   - validator.py（合法的校验逻辑）
#   - 测试断言（validate_target / assert / def test_）
#   - 注释行
echo "  [R2] IP 段扫描检测..."

CIDR_VIOLATIONS=$(grep -rPn "\d+\.\d+\.\d+\.\d+/\d+" lightshield/ --include="*.py" 2>/dev/null \
    | grep -v "validator.py" \
    | grep -v "logger.py" \
    | grep -v "is_cidr\|test_cidr" \
    | grep -v "validate_target\|_validate_request" \
    | grep -v "def test_\|assert \|print(" \
    | grep -v "#" \
    | grep -v "^$" || true)

if [ -n "$CIDR_VIOLATIONS" ]; then
    echo "  ❌ R2 违规：检测到 CIDR IP 段（仅 validator.py 的检测逻辑允许）"
    echo "$CIDR_VIOLATIONS"
    PASS=false
else
    echo "  ✅ R2 通过"
fi

# =============================================================================
# SEC: 硬编码密钥/Token 检测
# =============================================================================
echo "  [SEC] 硬编码密钥检测..."

SECRET_VIOLATIONS=$(grep -rInE \
    "AKIA[0-9A-Z]{16}|ghp_[0-9a-zA-Z]{36}|github_pat_[0-9a-zA-Z]{22}_[0-9a-zA-Z]{59}|sk-[0-9a-zA-Z]{48}|xox[baprs]-[0-9a-zA-Z-]+" \
    lightshield/ --include="*.py" 2>/dev/null \
    | grep -v "#" \
    | grep -v "^$" || true)

# 检测通用硬编码凭证模式
HARDCODED_CREDS=$(grep -rInE \
    "(password|passwd|secret|api_key|apikey|token)\s*=\s*['\"][^'\"]{8,}['\"]" \
    lightshield/ --include="*.py" 2>/dev/null \
    | grep -v "WEAK_PASSWORD_PATTERNS\|#\|example\|test_\|mock\|placeholder\|your-\|changeme\|PASSWORD" \
    | grep -v "^$" || true)

if [ -n "$SECRET_VIOLATIONS" ]; then
    echo "  ❌ SEC 违规：检测到疑似硬编码密钥/Token"
    echo "$SECRET_VIOLATIONS"
    PASS=false
elif [ -n "$HARDCODED_CREDS" ]; then
    echo "  ⚠️  疑似硬编码凭证（请人工确认）："
    echo "$HARDCODED_CREDS"
else
    echo "  ✅ 密钥检测通过"
fi

# =============================================================================
# DEP: hackingtool import 检查
# =============================================================================
echo "  [DEP] hackingtool 引用检查..."

HT_VIOLATIONS=$(grep -rInE "from hackingtool|import hackingtool" lightshield/ --include="*.py" 2>/dev/null \
    | grep -v "#" \
    | grep -v "hackingtool 不作为依赖" \
    | grep -v "^$" || true)

if [ -n "$HT_VIOLATIONS" ]; then
    echo "  ❌ 架构违规：hackingtool 不作为依赖（仅允许设计参考注释）"
    echo "$HT_VIOLATIONS"
    PASS=false
else
    echo "  ✅ 依赖检查通过"
fi

# =============================================================================
# 注意：ruff 代码风格检查已由 pre-commit 框架的 ruff + ruff-format hook 接管，
# 此处不再重复执行。
# =============================================================================

# =============================================================================
# 最终判断
# =============================================================================
echo "════════════════════════════════════════"
if [ "$PASS" = true ]; then
    echo "✅ Gate A 合规扫描全部通过"
    exit 0
else
    echo "❌ Gate A 合规扫描未通过 — commit 已拦截"
    echo ""
    echo "修复建议："
    echo "  1. 搜索并移除违规关键字代码（注意：测试文件不计入）"
    echo "  2. 确保 MSF 调用仅使用 auxiliary/scanner/* 白名单路径"
    echo "  3. 确保 IP 校验逻辑只在 validator.py 中"
    echo "  4. 确保不 import hackingtool"
    exit 1
fi
